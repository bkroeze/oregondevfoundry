package templates

templ ServicesPage(account AccountView) {
	<!DOCTYPE html>
	<html lang="en">
		@PageHead("Services")
		<body>
			<a class="skip-link" href="#main">Skip to content</a>
			@SiteHeader(account)
			<main id="main" class="services-main">
				<section class="services-hero section-pad">
					<div class="section-heading">
						<p class="kicker">The catalog / Services</p>
						<h1>Useful services, built to be used.</h1>
						<p>We turn recurring, practical problems into durable service offerings—starting with the people who sell face to face.</p>
					</div>
					<div class="services-grid">
						<article class="service-card service-card-featured">
							<span class="plate">Artists, makers &amp; growers · Market vendors</span>
							<h3>Custom QR code signage</h3>
							<p>Slate tabletop displays for your shop, menu, or payment destination, with an optional wooden stand. Explore the available sizes and saved product photos, then contact us to discuss your sign.</p>
							<ul class="market-list">
								<li>Farmers markets</li>
								<li>Art &amp; craft fairs</li>
								<li>Pop-up shops</li>
								<li>Nursery &amp; grower tables</li>
								<li>Food &amp; drink vendors</li>
							</ul>
							<a class="button button-primary" href="/shop/vending-signage">Configure vending signage <span>↗</span></a>
						</article>
						<article class="service-card service-card-soon">
							<span class="plate plate-dark">In the works</span>
							<h3>More vendor tools</h3>
							<p>Inventory sheets, market-day checklists, and simple storefronts—shaped by what real vendors keep asking us for.</p>
							<a class="status" href="/#contact">Tell us what you need <span>↗</span></a>
						</article>
					</div>
				</section>
			</main>
			@PageFooter()
		</body>
	</html>
}

type SignageOption struct {
	ID string
	Name string
	Active bool
	Selected bool
	ImageURL string
	StandImageURL string
}

type SignagePageData struct {
	Account AccountView
	Options []SignageOption
	StandID string
	StandActive bool
	Available bool
	ImageURL string
	ImageAlt string
}

templ VendingSignagePage(data SignagePageData) {
	<!DOCTYPE html>
	<html lang="en">
		@PageHead("Slate vending signage")
		<body>
			<a class="skip-link" href="#main">Skip to content</a>
			@SiteHeader(data.Account)
			<main id="main" class="product-main" data-signage>
				<section class="product-hero section-pad">
					<div class="product-layout">
						<div class="product-copy">
							<p class="kicker">Market vendors / Signage</p>
							<h1>Slate signage.<br/>Made for your table.</h1>
							<p class="product-intro">Explore a slate display for your shop, menu, or payment destination, with an optional wooden stand.</p>
							<p>This is a preview and inquiry tool, not a checkout. Contact us to discuss your sign and confirm the details.</p>
						</div>
						<div class="product-preview signage-preview">
							<img data-signage-image alt={ data.ImageAlt } hidden?={ data.ImageURL == "" }
								if data.ImageURL != "" {
									src={ data.ImageURL }
								}
							/>
							<p data-signage-empty hidden?={ data.ImageURL != "" }>No saved photograph is available for this configuration yet.</p>
							<p class="signage-caption">Saved product photos only. Your title and destination do not change the photograph; no QR code is generated here.</p>
							<p class="signage-caption" data-signage-status role="status" aria-live="polite"></p>
						</div>
					</div>
				</section>
				<section class="product-config-section section-pad">
					<div class="section-heading">
						<p class="kicker">Explore your sign</p>
						<h2>Choose the options.</h2>
						<p>Unavailable sizes remain visible so you can see the range. Only currently enabled options can be selected.</p>
					</div>
					<div class="product-config">
						<fieldset class="option-group">
							<legend>Slate size</legend>
							<div class="option-grid">
								for _, option := range data.Options {
									<label>
										<input type="radio" name="signage-size" value={ option.ID } checked?={ option.Selected } disabled?={ !option.Active } data-signage-size data-name={ option.Name } data-image={ option.ImageURL } data-stand-image={ option.StandImageURL }/>
										<span>{ option.Name }
											if !option.Active {
												<small> — currently unavailable</small>
											}
										</span>
									</label>
								}
							</div>
							if !data.Available {
								<p>No slate sizes are currently available. Please contact us to discuss availability.</p>
							}
						</fieldset>
						<fieldset class="option-group">
							<legend>Display accessory</legend>
							<div class="option-grid">
								<label>
									<input type="checkbox" name="signage-stand" value={ data.StandID } data-signage-stand disabled?={ !data.StandActive || !data.Available }/>
									<span>Add wooden stand?
										if !data.StandActive {
											<small> — currently unavailable</small>
										}
									</span>
								</label>
							</div>
						</fieldset>
						<div class="signage-fields">
							<label for="signage-title">Title <span>(up to 20 characters)</span></label>
							<input id="signage-title" name="signage-title" type="text" maxlength="20" aria-describedby="signage-details-note"/>
							<label for="signage-destination">Destination URL <span>(up to 200 characters)</span></label>
							<input id="signage-destination" name="signage-destination" type="url" maxlength="200" placeholder="https://example.com/shop" aria-describedby="signage-details-note"/>
							<p id="signage-details-note">These details are for planning only: they are not saved or sent. Include your title, destination URL, size, and stand preference when you contact us. The saved photo is not a personalized proof.</p>
						</div>
						<noscript><p>JavaScript is needed to switch saved photographs when you change options. The initial photograph, if available, shows the default size without a stand.</p></noscript>
						<div class="config-actions">
							<a class="button button-primary" href="/#contact">Ask about slate signage <span>↗</span></a>
							<p class="config-note">Preview and inquiry only—no order or payment is submitted here.</p>
						</div>
					</div>
				</section>
			</main>
			@PageFooter()
		</body>
	</html>
}
