	</html>
}

templ AdminLandingPage(account AccountView) {
	<!DOCTYPE html>
	<html lang="en">
		@PageHead("Admin")
		<body>
			<a class="skip-link" href="#main">Skip to content</a>
			@SiteHeader(account)
