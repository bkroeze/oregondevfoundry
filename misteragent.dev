#!/usr/bin/env bash
# nopasswd-sudo v1.0 - temporary passwordless sudo with expiry and audit.
#
# Validates every sudoers drop via visudo -cf before touching /etc/sudoers.d.
# Auto-expiry uses a systemd --on-active timer; on re-arm the old timer is
# cancelled first so no orphan timers accumulate. A rebooted timer restarts
# its countdown, so every drop embeds its deadline epoch and every root
# invocation sweeps drops whose deadline has passed.
set -uo pipefail

readonly PROG="${0##*/}"
readonly SUDOERS_D="/etc/sudoers.d"
readonly DROP_PREFIX="50-nopasswd"

# --- colours (only when stdout is a tty) -----------------------------------
if [[ -t 1 ]]; then
    readonly RED='\033[0;31m'
    readonly NC='\033[0m'
else
    readonly RED='' NC=''
fi

# --- helpers ---------------------------------------------------------------

die() {
    printf '%s: %s\n' "$PROG" "$*" >&2
    exit 1
}

info() {
    printf '%s: %s\n' "$PROG" "$*" >&2
}

# The grant target: the invoking user behind sudo, not root itself.
user() {
    printf '%s' "${SUDO_USER:-$(id -un)}"
}

require_root() {
    if [[ "$(id -u)" != "0" ]]; then
        die "this action needs root - run with sudo"
    fi
}

drop_path() {
    local u="${1:-$(user)}"
    printf '%s/%s-%s-temp' "$SUDOERS_D" "$DROP_PREFIX" "$u"
}

unit_name() {
    local u="${1:-$(user)}"
    printf 'nopasswd-sudo-%s' "$u"
}

timer_path() {
    local u="${1:-$(user)}"
    printf '/etc/systemd/system/%s.timer' "$(unit_name "$u")"
}

service_path() {
    local u="${1:-$(user)}"
    printf '/etc/systemd/system/%s.service' "$(unit_name "$u")"
}

validate_sudoers() {
    local tmp="$1"
    visudo -cf "$tmp" >/dev/null 2>&1
}

# Emits two sudoers lines: the audit Defaults on its own line (a Defaults
# directive is not valid appended to a user spec), then the grant itself.
gen_grant_line() {
    local user="$1" scope="$2"
    printf 'Defaults:%s log_output\n' "$user"
    if [[ "$scope" == "ALL" ]]; then
        printf '%s ALL=(ALL) NOPASSWD: ALL' "$user"
    else
        printf '%s ALL=(ALL) NOPASSWD: %s' "$user" "$scope"
    fi
}

DRY_RUN="no"

schedule_expiry() {
    local u="$1" hours="$2" deadline_epoch="$3"
    # shellcheck disable=SC2155
    local svc="$(service_path "$u")"
    # shellcheck disable=SC2155
    local tmr="$(timer_path "$u")"

    mkdir -p "$(dirname "$svc")"

    # the service the timer fires: revoke the grant, then clean up the
    # units behind it (leading - tolerates cleanup failures, the grant
    # removal itself must succeed)
    cat > "$svc" << EOF
[Unit]
Description=Remove nopasswd sudo grant for ${u}

[Service]
Type=oneshot
ExecStart=/bin/rm -f '$(drop_path "$u")'
ExecStart=-/usr/bin/systemctl disable '$(unit_name "$u").timer'
ExecStart=-/bin/rm -f '${tmr}' '${svc}'
ExecStart=-/usr/bin/systemctl daemon-reload
EOF

    # write the timer with OnActiveSec
    cat > "$tmr" << EOF
[Unit]
Description=Expire nopasswd sudo grant for ${u} after ${hours}h

[Timer]
OnActiveSec=${hours}h
Persistent=false

[Install]
WantedBy=timers.target
EOF

    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable --now "$(unit_name "$u").timer" >/dev/null 2>&1 || true
}

cancel_timer() {
    local u="$1"
    # shellcheck disable=SC2155
    local tmr="$(timer_path "$u")"
    # shellcheck disable=SC2155
    local svc="$(service_path "$u")"

    # systemctl may not be available or unit may be absent, that's fine
    systemctl disable --now "$(unit_name "$u").timer" >/dev/null 2>&1 || true
    rm -f "$tmr" "$svc"
    systemctl daemon-reload >/dev/null 2>&1 || true
}

do_off() {
    local u
    u="$(user)"
    local drop
    drop="$(drop_path "$u")"

    if [[ "$DRY_RUN" == "yes" ]]; then
        info "DRY-RUN: would remove $drop"
        info "DRY-RUN: would cancel timer and service for $u"
        return 0
    fi

    cancel_timer "$u"

    if [[ -f "$drop" ]]; then
        rm -f "$drop"
        info "grant revoked: $drop"
    else
        info "no grant found for $(user) (idempotent)"
    fi
}

parse_deadline_from_drop() {
    local drop="$1"
    grep '^# deadline-epoch=' "$drop" 2>/dev/null | tail -1 |
        sed 's/^# deadline-epoch=//'
}

fmt_remaining() {
    local epoch="$1"
    local now
    now="$(date +%s)"
    local diff=$((epoch - now))
    if (( diff <= 0 )); then
        printf 'expired'
        return
    fi
    local h=$((diff / 3600))
    local m=$(((diff % 3600) / 60))
    if (( h > 0 )); then
        printf '%dh %dm remaining' "$h" "$m"
    else
        printf '%dm remaining' "$m"
    fi
}

do_status() {
    local u
    u="$(user)"
    local drop
    drop="$(drop_path "$u")"

    if [[ ! -f "$drop" ]]; then
        local orphan_drop
        orphan_drop="$(find "$SUDOERS_D" -name "${DROP_PREFIX}-*-temp" -printf '%p\n' 2>/dev/null | head -1)"
        if [[ -n "$orphan_drop" ]]; then
            local orphan_user
            orphan_user="${orphan_drop#*${DROP_PREFIX}-}"
            orphan_user="${orphan_user%-temp}"
            printf '%s: OFF (orphan drop exists for %s at %s)\n' \
                "$PROG" "$orphan_user" "$orphan_drop"
        else
            printf '%s: OFF\n' "$PROG"
        fi
        return 0
    fi

    local scope
    scope="$(grep -E '^[^#]*NOPASSWD:' "$drop" 2>/dev/null | head -1 |
        sed 's/.*NOPASSWD: //')"
    [[ -n "$scope" ]] || scope="ALL"

    printf '%s: ON\n' "$PROG"
    printf '  drop: %s\n' "$drop"
    printf '  scope: %s\n' "$scope"

    if systemctl list-timers --all 2>/dev/null | grep -q "$(unit_name "$u")"; then
        printf '  timer: armed\n'
    else
        printf '  timer: none (grant may be permanent)\n'
    fi

    local embedded
    embedded="$(parse_deadline_from_drop "$drop")"
    if [[ -n "$embedded" && "$embedded" != "0" ]]; then
        printf '  deadline (from drop): %s (%s)\n' \
            "$(date -d "@$embedded" 2>/dev/null || echo "$embedded")" \
            "$(fmt_remaining "$embedded")"
    fi

    if [[ -n "$embedded" && "$embedded" != "0" ]]; then
        if (( embedded > 0 && $(date +%s) >= embedded )); then
            printf '  %sWARNING: orphan - deadline has passed%s\n' "$RED" "$NC"
        fi
    fi
}

# --- sweep: reboot-safe expiry ---------------------------------------------
# Runs on every root invocation and via the sweep subcommand. Finds all
# matching drop files and removes those whose embedded epoch deadline is
# in the past. The env var guard keeps it from running twice per process.

do_sweep() {
    if [[ "${NOPASSWD_SWEEP_RUNNING:-no}" == "yes" ]]; then
        return 0
    fi
    export NOPASSWD_SWEEP_RUNNING=yes

    local now
    now="$(date +%s)"
    local drop

    for drop in "$SUDOERS_D/${DROP_PREFIX}"-*-temp; do
        [[ -f "$drop" ]] || continue

        local embedded
        embedded="$(parse_deadline_from_drop "$drop")"
        [[ -n "$embedded" ]] || continue

        if (( embedded > 0 && now >= embedded )); then
            local u="${drop#*${DROP_PREFIX}-}"
            u="${u%-temp}"
            cancel_timer "$u"
            rm -f "$drop"
            info "sweep: removed expired grant for $u"
        fi
    done
}

# --- main dispatch ----------------------------------------------------------

usage() {
    cat << USAGE >&2
Usage: $PROG {on [hours] | off | status | sweep} [options]

Temporary passwordless sudo with expiry and audit logging.

Commands:
  on [hours]       Grant temporary passwordless sudo (default 4h, 0 = perma)
  off              Revoke the grant
  status           Show grant state, scope, and expiry
  sweep            Reap every expired grant (also runs on any root call)

Options:
  --dry-run        Print what would happen without touching anything
  --allow cmd,...  Scope the grant to named commands (absolute paths)

Examples:
  $PROG on          # grant 4h sudo
  $PROG on 2        # grant 2h sudo
  $PROG on 0        # grant permanent sudo
  $PROG on 4 --allow ls,systemctl
  $PROG off
  $PROG status
  $PROG --dry-run on 2
USAGE
}

main() {
    if [[ $# -eq 0 ]]; then
        usage
        exit 1
    fi

    # Global flags parsed in a loop so they apply to any subcommand
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run)
                DRY_RUN="yes"
                shift
                ;;
            on|off|status|sweep)
                # delegated below
                break
                ;;
            *)
                die "unknown option: $1 (try --dry-run, --allow, or a subcommand)"
                ;;
        esac
    done

    # reap expired grants on every privileged invocation (reboot-safe
    # expiry: a rebooted timer restarts its countdown, the embedded
    # deadline does not lie)
    if [[ "$(id -u)" == "0" && "$DRY_RUN" == "no" ]]; then
        do_sweep
    fi

    case "${1:-}" in
        on)
            shift
            [[ "$DRY_RUN" == "yes" ]] || require_root
            do_on_impl "$@"
            ;;
        off)
            [[ "$DRY_RUN" == "yes" ]] || require_root
            do_off
            ;;
        status)
            do_status
            ;;
        sweep)
            require_root
            do_sweep
            ;;
        *)
            usage
            exit 1
            ;;
    esac
}

# do_on_impl: like do_on but takes a pre-computed deadline epoch
# and injects it as a comment header in the drop file for reboot-safe expiry.

do_on_impl() {
    local hours="4"
    local scope="ALL"
    local deadline_epoch="0"

    # Parse positional hours and --allow options
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run)
                DRY_RUN="yes"
                shift
                ;;
            --allow)
                shift
                [[ $# -eq 0 ]] && die "--allow requires a comma-separated list of commands"
                scope="$1"
                shift
                ;;
            [0-9]*)
                [[ "$1" =~ ^[0-9]+$ ]] || die "invalid hours: $1 (whole number required)"
                hours="$1"
                shift
                ;;
            *)
                die "unknown option for on: $1"
                ;;
        esac
    done

    local u
    u="$(user)"
    [[ "$u" != "root" ]] || die "refusing a grant for root - run via sudo from your own user"
    local drop
    drop="$(drop_path "$u")"

    # compute deadline epoch
    if [[ "$hours" == "0" ]]; then
        deadline_epoch="0"
    else
        deadline_epoch=$(( $(date +%s) + hours * 3600 ))
    fi

    # validate scope commands exist and resolve each to an absolute path,
    # since sudoers requires fully-qualified command paths.
    if [[ "$scope" != "ALL" ]]; then
        local resolved=""
        local cmd abspath
        local IFS=,
        for cmd in $scope; do
            cmd="${cmd#"${cmd%%[![:space:]]*}"}"   # trim leading space
            cmd="${cmd%"${cmd##*[![:space:]]}"}"    # trim trailing space
            abspath="$(command -v "$cmd" 2>/dev/null)"
            if [[ -z "$abspath" || "$abspath" != /* ]]; then
                die "command not found in PATH (or not an absolute path): $cmd"
            fi
            resolved="${resolved:+$resolved, }$abspath"
        done
        scope="$resolved"
    fi

    # build grant content for validation
    local grant_line
    grant_line="$(gen_grant_line "$u" "$scope")"

    # create temp file for visudo validation
    local tmp
    tmp="$(mktemp)"

    printf '# nopasswd-sudo temporary grant\n# deadline-epoch=%s\n%s\n' \
        "$deadline_epoch" "$grant_line" > "$tmp"

    if ! validate_sudoers "$tmp"; then
        rm -f "$tmp"
        die "visudo validation failed - refusing to install"
    fi

    # dry-run: report every side effect and change nothing
    if [[ "$DRY_RUN" == "yes" ]]; then
        info "DRY-RUN: would cancel any existing timer for $u"
        info "DRY-RUN: would install grant to $drop"
        if [[ "$hours" != "0" ]]; then
            info "DRY-RUN: would schedule expiry in ${hours}h"
        else
            info "DRY-RUN: would grant with no expiry (permanent)"
        fi
        rm -f "$tmp"
        return 0
    fi

    # cancel any existing timer to prevent orphans on re-arm
    cancel_timer "$u"

    # install the already-validated temp file directly; install sets mode and
    # owner atomically, and reusing the validated file guarantees the installed
    # drop matches byte-for-byte (so the deadline header parses back).
    install -m 0440 -o root -g root "$tmp" "$drop"

    # schedule expiry (skip for permanent grants)
    if [[ "$hours" != "0" ]]; then
        schedule_expiry "$u" "$hours" "$deadline_epoch"
    fi

    info "grant active: $drop (expires in ${hours}h)"
}

main "$@"